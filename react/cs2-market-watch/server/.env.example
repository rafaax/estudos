# Copie este arquivo para .env e preencha os valores. Nunca versione o .env.
PORT=3001

BITSKINS_API_KEY=sua_chave_da_api_do_bitskins
# Segredo de 2FA (TOTP) da conta do BitSkins, usado para gerar o código de autenticação
BITSKINS_SECRET=seu_segredo_2fa_do_bitskins

CSFLOAT_API_KEY=sua_chave_da_api_do_csfloat

# Cookie steamLoginSecure da sua sessão na Steam, para o histórico de preços
STEAM_LOGIN_SECURE=seu_cookie_steamloginsecure
