# Copie este arquivo para .env e preencha os valores.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=usuario
DB_PASSWORD=senha
DB_DATABASE=nome_do_banco
JWT_SECRET=troque_por_um_segredo_longo

# Com ENV=development o TypeORM sincroniza o esquema do banco automaticamente.
ENV=development

# Servidor SMTP usado no e-mail de recuperação de senha.
# Para testar, crie uma conta gratuita em https://ethereal.email
MAIL_HOST=smtp.ethereal.email
MAIL_USER=usuario_do_smtp
MAIL_PASS=senha_do_smtp
